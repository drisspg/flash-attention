+  dtype: bfloat16
+  seed: 0
+  workers: 16
+  rounds: 7
+  iters_per_round: 31
+  warmup_iters: 10
+  clock_warmup_iters: 20
+
+experiments:
+  - name: d64_direct_long_noncausal_mha
+    baseline: {use_tma_o: true}
